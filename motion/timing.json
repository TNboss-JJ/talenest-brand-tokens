{
  "$schema": "https://talenest.org/schemas/brand-tokens/motion.json",
  "description": "TaleNest motion design tokens — soft, child-friendly easings",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "tokens": {
    "duration": {
      "instant":  "0ms",
      "fast":     "150ms",
      "normal":   "200ms",
      "slow":     "300ms",
      "deliberate": "450ms"
    },
    "easing": {
      "linear":   "linear",
      "in":       "cubic-bezier(0.4, 0, 1, 1)",
      "out":      "cubic-bezier(0, 0, 0.2, 1)",
      "in_out":   "cubic-bezier(0.4, 0, 0.2, 1)",
      "soft":     "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
      "bounce":   "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "presets": {
      "fade_in":      "200ms cubic-bezier(0, 0, 0.2, 1)",
      "slide_up":     "300ms cubic-bezier(0.25, 0.46, 0.45, 0.94)",
      "scale_press":  "150ms cubic-bezier(0.4, 0, 1, 1)",
      "soft_landing": "450ms cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  }
}
